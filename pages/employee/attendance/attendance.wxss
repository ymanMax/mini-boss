.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 标签切换样式 */
.tab-container {
  display: flex;
  background-color: white;
  border-bottom: 2rpx solid #e0e0e0;
}

.tab {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #019fa0;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #019fa0;
}

/* 内容区域样式 */
.content {
  padding: 20rpx;
}

/* 添加按钮样式 */
.add-btn-container {
  margin-bottom: 30rpx;
}

.add-btn {
  width: 100%;
  padding: 25rpx;
  background-color: #019fa0;
  color: white;
  border: none;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: bold;
}

/* 考勤记录列表样式 */
.attendance-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.attendance-item {
  background-color: white;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.attendance-header {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.employee-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.employee-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.date {
  font-size: 26rpx;
  color: #999;
}

.status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.status-正常 {
  background-color: #c8e6c9;
  color: #2e7d32;
}

.status-迟到 {
  background-color: #ffccbc;
  color: #c62828;
}

.status-早退 {
  background-color: #ffccbc;
  color: #c62828;
}

.status-旷工 {
  background-color: #ffcdd2;
  color: #c62828;
}

.attendance-details {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.time-info {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
}

.working-hours {
  font-size: 26rpx;
  color: #666;
}

.note {
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

/* 请假申请列表样式 */
.leave-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.leave-item {
  background-color: white;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.leave-header {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.leave-type {
  font-size: 26rpx;
  color: #1565c0;
  background-color: #e3f2fd;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  align-self: flex-start;
}

.status-待审批 {
  background-color: #fff9c4;
  color: #f57c00;
}

.status-已批准 {
  background-color: #c8e6c9;
  color: #2e7d32;
}

.status-已拒绝 {
  background-color: #ffcdd2;
  color: #c62828;
}

.leave-details {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.date-range {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #333;
}

.days {
  color: #999;
}

.reason {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.approval-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
}

.comment {
  font-size: 24rpx;
  color: #999;
  font-style: italic;
  background-color: #f5f5f5;
  padding: 15rpx;
  border-radius: 8rpx;
}

.leave-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  padding: 15rpx 30rpx;
  border: none;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.approve-btn {
  background-color: #019fa0;
  color: white;
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-text {
  font-size: 32rpx;
}
