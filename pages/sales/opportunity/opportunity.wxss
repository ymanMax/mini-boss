/* 销售机会页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 顶部操作栏 */
.top-bar {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.add-btn, .report-btn {
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
}

.add-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.report-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
}

.add-btn:active, .report-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 区域标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #e0e0e0;
}

/* 销售概览 */
.overview-section {
  margin-bottom: 40rpx;
}

.overview-cards {
  display: flex;
  gap: 20rpx;
  overflow-x: auto;
  padding-bottom: 20rpx;
}

.overview-card {
  flex: 1;
  min-width: 240rpx;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.card-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.card-change {
  font-size: 24rpx;
}

.card-change.positive {
  color: #4CAF50;
}

.card-change.negative {
  color: #F44336;
}

/* 销售机会列表 */
.opportunity-section {
  margin-bottom: 40rpx;
}

.opportunity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.opportunity-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.opportunity-info {
  flex: 1;
  margin-right: 20rpx;
}

.opportunity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.opportunity-customer {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.opportunity-amount {
  font-size: 28rpx;
  color: #667eea;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.opportunity-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 15rpx;
  font-size: 24rpx;
}

.opportunity-meta .stage {
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
  color: white;
}

.stage-prospect {
  background: #FF9800;
}

.stage-qualify {
  background: #2196F3;
}

.stage-proposal {
  background: #9C27B0;
}

.stage-negotiation {
  background: #E91E63;
}

.stage-close {
  background: #4CAF50;
}

.opportunity-meta .probability {
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.opportunity-meta .close-date {
  color: #FF9800;
  background: rgba(255, 152, 0, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.opportunity-meta .assigned {
  color: #4CAF50;
  background: rgba(76, 175, 80, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.opportunity-description {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.opportunity-actions {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.detail-btn {
  background: #f0f0f0;
  color: #333;
  border: none;
  border-radius: 8rpx;
  padding: 15rpx 20rpx;
  font-size: 26rpx;
  min-width: 100rpx;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #e0e0e0;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
  overflow-y: auto;
  flex: 1;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.form-item input,
.form-item textarea,
.form-item .picker {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  background: white;
}

.form-item textarea {
  min-height: 120rpx;
  resize: none;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 2rpx solid #e0e0e0;
}

.modal-footer button {
  border: none;
  border-radius: 10rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  min-width: 120rpx;
}

.cancel-btn {
  background: #f0f0f0;
  color: #333;
}

.confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}