/* pages/finance/invoice/invoice.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: white;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.back-btn {
  font-size: 28rpx;
  color: #019fa0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.empty {
  width: 80rpx;
}

.invoices-list {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.invoice-item {
  background-color: white;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.invoice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.invoice-id {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.invoice-status {
  padding: 8rpx 16rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
}

.invoice-status.verified {
  background-color: #f6ffed;
  color: #52c41a;
}

.invoice-status.recorded {
  background-color: #e6f7ff;
  color: #1890ff;
}

.invoice-status.pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

.invoice-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.invoice-date {
  font-size: 26rpx;
  color: #666;
}

.invoice-type {
  font-size: 28rpx;
  color: #019fa0;
}

.invoice-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.invoice-customer {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.invoice-tax {
  font-size: 26rpx;
  color: #999;
}
