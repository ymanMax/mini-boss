<!--pages/finance/analysis/analysis.wxml-->
<view class="container">
  <view class="page-header">
    <text class="back-btn" bindtap="goBack">← 返回</text>
    <text class="title">财务分析</text>
    <view class="empty"></view>
  </view>

  <!-- 月度趋势分析 -->
  <view class="analysis-section">
    <view class="section-title">月度趋势分析</view>
    <view class="trend-list">
      <view wx:for="{{monthlyTrend}}" wx:key="month" class="trend-item">
        <view class="trend-month">{{item.month}}</view>
        <view class="trend-details">
          <view class="trend-item-detail">
            <text class="detail-label">收入</text>
            <text class="detail-value income">¥{{item.income.toLocaleString()}}</text>
          </view>
          <view class="trend-item-detail">
            <text class="detail-label">支出</text>
            <text class="detail-value expense">¥{{item.expense.toLocaleString()}}</text>
          </view>
          <view class="trend-item-detail">
            <text class="detail-label">利润</text>
            <text class="detail-value {{item.profit >= 0 ? 'profit' : 'loss'}}">¥{{item.profit.toLocaleString()}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 费用分类占比 -->
  <view class="analysis-section">
    <view class="section-title">费用分类占比</view>
    <view class="category-list">
      <view wx:for="{{expenseCategories}}" wx:key="category" class="category-item">
        <view class="category-info">
          <view class="category-name">{{item.category}}</view>
          <view class="category-percentage">{{item.percentage}}%</view>
        </view>
        <view class="category-bar">
          <view class="bar-fill" style="width: {{item.percentage}}%"></view>
        </view>
        <view class="category-amount">¥{{item.amount.toLocaleString()}}</view>
      </view>
    </view>
  </view>
</view>
