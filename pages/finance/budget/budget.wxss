/* pages/finance/budget/budget.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: white;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.back-btn {
  font-size: 28rpx;
  color: #019fa0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.empty {
  width: 80rpx;
}

.budget-list {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.budget-item {
  background-color: white;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.budget-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.budget-category {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.budget-status {
  padding: 8rpx 16rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
}

.budget-status.under {
  background-color: #f6ffed;
  color: #52c41a;
}

.budget-status.over {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.budget-period {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.budget-details {
  display: flex;
  justify-content: space-between;
}

.budget-item-detail {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.detail-value.positive {
  color: #07c160;
}

.detail-value.negative {
  color: #ff4d4f;
}
