/* pages/finance/voucher/voucher.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: white;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.back-btn {
  font-size: 28rpx;
  color: #019fa0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.empty {
  width: 80rpx;
}

.vouchers-list {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.voucher-item {
  background-color: white;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.voucher-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.voucher-id {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.voucher-status {
  padding: 8rpx 16rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
}

.voucher-status.approved {
  background-color: #f6ffed;
  color: #52c41a;
}

.voucher-status.pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

.voucher-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.voucher-date {
  font-size: 26rpx;
  color: #666;
}

.voucher-type {
  font-size: 28rpx;
  color: #019fa0;
}

.voucher-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.voucher-summary {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.voucher-footer {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}
