<view class="container">
  <!-- 顶部标签栏 -->
  <view class="tab-bar">
    <view
      class="tab-item {{activeTab === 'projects' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="projects"
    >
      项目管理
    </view>
    <view
      class="tab-item {{activeTab === 'tasks' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="tasks"
    >
      任务分配
    </view>
    <view
      class="tab-item {{activeTab === 'team' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="team"
    >
      团队协作
    </view>
    <view
      class="tab-item {{activeTab === 'files' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="files"
    >
      文件共享
    </view>
    <view
      class="tab-item {{activeTab === 'budget' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="budget"
    >
      成本预算
    </view>
    <view
      class="tab-item {{activeTab === 'risks' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="risks"
    >
      风险管理
    </view>
  </view>

  <!-- 项目管理标签内容 -->
  <view wx:if="{{activeTab === 'projects'}}" class="tab-content">
    <view class="header">
      <text class="title">项目列表</text>
      <button class="add-btn" bindtap="showCreateProjectModal">+ 新建项目</button>
    </view>

    <view class="project-list">
      <view wx:for="{{projects}}" wx:key="id" class="project-item">
        <view class="project-info">
          <view class="project-name">{{item.name}}</view>
          <view class="project-desc">{{item.description}}</view>
          <view class="project-meta">
            <text class="meta-item">负责人: {{item.manager}}</text>
            <text class="meta-item">开始: {{item.startDate}}</text>
            <text class="meta-item">结束: {{item.endDate}}</text>
          </view>
        </view>

        <view class="project-stats">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{item.progress}}%"></view>
          </view>
          <text class="progress-text">{{item.progress}}%</text>
          <view class="status-badge status-{{item.status}}">{{item.status}}</view>
        </view>

        <view class="project-actions">
          <button
            class="action-btn"
            bindtap="updateProjectStatus"
            data-project-id="{{item.id}}"
            data-status="planning"
          >
            规划中
          </button>
          <button
            class="action-btn"
            bindtap="updateProjectStatus"
            data-project-id="{{item.id}}"
            data-status="in_progress"
          >
            进行中
          </button>
          <button
            class="action-btn"
            bindtap="updateProjectStatus"
            data-project-id="{{item.id}}"
            data-status="completed"
          >
            已完成
          </button>
          <button
            class="action-btn"
            bindtap="addRisk"
            data-project-id="{{item.id}}"
          >
            添加风险
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 任务分配标签内容 -->
  <view wx:if="{{activeTab === 'tasks'}}" class="tab-content">
    <view class="header">
      <text class="title">任务列表</text>
    </view>

    <view class="task-list">
      <view wx:for="{{tasks}}" wx:key="id" class="task-item">
        <view class="task-info">
          <view class="task-name">{{item.name}}</view>
          <view class="task-desc">{{item.description}}</view>
          <view class="task-meta">
            <text class="meta-item">项目: {{item.projectName}}</text>
            <text class="meta-item">负责人: {{item.assignee}}</text>
            <text class="meta-item">截止: {{item.deadline}}</text>
          </view>
        </view>

        <view class="task-stats">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{item.progress}}%"></view>
          </view>
          <text class="progress-text">{{item.progress}}%</text>
          <view class="status-badge status-{{item.status}}">{{item.status}}</view>
        </view>

        <view class="task-actions">
          <button
            class="action-btn"
            bindtap="assignTask"
            data-task-id="{{item.id}}"
            data-user-id="张三"
          >
            分配给张三
          </button>
          <button
            class="action-btn"
            bindtap="assignTask"
            data-task-id="{{item.id}}"
            data-user-id="李四"
          >
            分配给李四
          </button>
          <button
            class="action-btn"
            bindtap="updateTaskProgress"
            data-task-id="{{item.id}}"
            data-progress="50"
          >
            50%
          </button>
          <button
            class="action-btn"
            bindtap="updateTaskProgress"
            data-task-id="{{item.id}}"
            data-progress="100"
          >
            完成
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 团队协作标签内容 -->
  <view wx:if="{{activeTab === 'team'}}" class="tab-content">
    <view class="header">
      <text class="title">团队成员</text>
    </view>

    <view class="team-list">
      <view wx:for="{{teamMembers}}" wx:key="id" class="team-member">
        <view class="member-avatar">{{item.name.charAt(0)}}</view>
        <view class="member-info">
          <view class="member-name">{{item.name}}</view>
          <view class="member-role">{{item.role}}</view>
          <view class="member-stats">
            <text class="stat-item">完成任务: {{item.completedTasks}}</text>
            <text class="stat-item">参与项目: {{item.projects}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 文件共享标签内容 -->
  <view wx:if="{{activeTab === 'files'}}" class="tab-content">
    <view class="header">
      <text class="title">文件共享</text>
      <button class="add-btn" bindtap="uploadFile">+ 上传文件</button>
    </view>

    <view class="file-list">
      <view wx:for="{{files}}" wx:key="id" class="file-item">
        <view class="file-info">
          <view class="file-name">{{item.name}}</view>
          <view class="file-meta">
            <text class="meta-item">上传者: {{item.uploader}}</text>
            <text class="meta-item">上传时间: {{item.uploadTime}}</text>
            <text class="meta-item">大小: {{item.size}}KB</text>
          </view>
        </view>
        <button class="download-btn">下载</button>
      </view>
    </view>
  </view>

  <!-- 成本预算标签内容 -->
  <view wx:if="{{activeTab === 'budget'}}" class="tab-content">
    <view class="header">
      <text class="title">成本预算管理</text>
    </view>

    <view class="budget-list">
      <view wx:for="{{projects}}" wx:key="id" class="budget-item">
        <view class="budget-info">
          <view class="project-name">{{item.name}}</view>
          <view class="budget-meta">
            <text class="meta-item">预算: ¥{{item.budget}}</text>
            <text class="meta-item">实际成本: ¥{{item.actualCost}}</text>
            <text class="meta-item">剩余: ¥{{item.budget - item.actualCost}}</text>
          </view>
        </view>
        <view class="budget-progress">
          <view class="progress-bar">
            <view
              class="progress-fill {{(item.actualCost / item.budget) > 0.8 ? 'warning' : ''}}"
              style="width: {{(item.actualCost / item.budget) * 100 || 0}}%"
            ></view>
          </view>
          <text class="progress-text">
            {{Math.round((item.actualCost / item.budget) * 100) || 0}}%
          </text>
        </view>
      </view>
    </view>
  </view>

  <!-- 风险管理标签内容 -->
  <view wx:if="{{activeTab === 'risks'}}" class="tab-content">
    <view class="header">
      <text class="title">项目风险管理</text>
    </view>

    <view class="risk-list">
      <view wx:for="{{risks}}" wx:key="id" class="risk-item">
        <view class="risk-info">
          <view class="risk-desc">{{item.description}}</view>
          <view class="risk-meta">
            <text class="meta-item">项目: {{item.projectName}}</text>
            <text class="meta-item">级别: {{item.level}}</text>
            <text class="meta-item">状态: {{item.status}}</text>
            <text class="meta-item">识别者: {{item.identifiedBy}}</text>
            <text class="meta-item">识别时间: {{item.identifiedTime}}</text>
          </view>
        </view>
        <view class="risk-actions">
          <button class="action-btn">处理</button>
          <button class="action-btn">忽略</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 创建项目弹窗 -->
  <view wx:if="{{showCreateProjectModal}}" class="modal-overlay" bindtap="hideCreateProjectModal">
    <view class="modal-content" catchtap>
      <view class="modal-header">
        <text class="modal-title">新建项目</text>
        <text class="modal-close" bindtap="hideCreateProjectModal">×</text>
      </view>

      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">项目名称</text>
          <input
            class="form-input"
            placeholder="请输入项目名称"
            value="{{newProject.name}}"
            bindinput="handleInputChange"
            data-field="name"
          />
        </view>

        <view class="form-item">
          <text class="form-label">项目描述</text>
          <textarea
            class="form-textarea"
            placeholder="请输入项目描述"
            value="{{newProject.description}}"
            bindinput="handleInputChange"
            data-field="description"
          ></textarea>
        </view>

        <view class="form-item">
          <text class="form-label">开始日期</text>
          <input
            class="form-input"
            placeholder="请选择开始日期"
            value="{{newProject.startDate}}"
            bindinput="handleInputChange"
            data-field="startDate"
          />
        </view>

        <view class="form-item">
          <text class="form-label">结束日期</text>
          <input
            class="form-input"
            placeholder="请选择结束日期"
            value="{{newProject.endDate}}"
            bindinput="handleInputChange"
            data-field="endDate"
          />
        </view>

        <view class="form-item">
          <text class="form-label">项目预算</text>
          <input
            class="form-input"
            type="number"
            placeholder="请输入项目预算"
            value="{{newProject.budget}}"
            bindinput="handleInputChange"
            data-field="budget"
          />
        </view>

        <view class="form-item">
          <text class="form-label">项目负责人</text>
          <input
            class="form-input"
            placeholder="请输入项目负责人"
            value="{{newProject.manager}}"
            bindinput="handleInputChange"
            data-field="manager"
          />
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="hideCreateProjectModal">取消</button>
        <button class="modal-btn confirm" bindtap="createProject">创建</button>
      </view>
    </view>
  </view>
</view>