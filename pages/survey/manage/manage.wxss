/* 客户满意度调查页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 顶部操作栏 */
.top-bar {
  margin-bottom: 30rpx;
  text-align: right;
}

.add-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 16rpx rgba(102, 126, 234, 0.3);
}

.add-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 8rpx rgba(102, 126, 234, 0.3);
}

/* 区域标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #e0e0e0;
}

/* 调查统计 */
.stats-section {
  margin-bottom: 40rpx;
}

.stats-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stats-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  text-align: center;
  flex: 1;
  min-width: 200rpx;
}

.card-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.card-label {
  font-size: 24rpx;
  color: #666;
}

/* 调查问卷列表 */
.survey-section {
  margin-bottom: 40rpx;
}

.survey-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.survey-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.survey-info {
  flex: 1;
  margin-right: 20rpx;
}

.survey-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.survey-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.survey-type {
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
  color: white;
  font-size: 24rpx;
  white-space: nowrap;
}

.type-satisfaction {
  background: #4CAF50;
}

.type-feedback {
  background: #2196F3;
}

.survey-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.survey-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 15rpx;
  font-size: 24rpx;
}

.survey-meta .status {
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
  color: white;
}

.status-draft {
  background: #9E9E9E;
}

.status-active {
  background: #4CAF50;
}

.status-closed {
  background: #607D8B;
}

.survey-meta .period {
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.survey-meta .responses {
  color: #FF9800;
  background: rgba(255, 152, 0, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.survey-meta .avg-score {
  color: #4CAF50;
  background: rgba(76, 175, 80, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.survey-time {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.survey-actions {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.status-buttons {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.status-btn {
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 15rpx;
  font-size: 24rpx;
  min-width: 120rpx;
  color: white;
}

.activate-btn {
  background: #4CAF50;
}

.close-btn {
  background: #607D8B;
}

.detail-btn, .results-btn, .send-btn {
  border: none;
  border-radius: 8rpx;
  padding: 15rpx 20rpx;
  font-size: 26rpx;
  min-width: 100rpx;
}

.detail-btn {
  background: #f0f0f0;
  color: #333;
}

.results-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.send-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #e0e0e0;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
  overflow-y: auto;
  flex: 1;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.form-item input,
.form-item textarea,
.form-item .picker {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  background: white;
}

.form-item textarea {
  min-height: 120rpx;
  resize: none;
}

.survey-summary {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
  font-size: 26rpx;
}

.summary-item:last-child {
  border-bottom: none;
}

.summary-item .value {
  font-weight: bold;
  color: #667eea;
}

.results-section {
  margin-top: 30rpx;
}

.result-item {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.result-item .question {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.result-item .avg-score {
  font-size: 26rpx;
  color: #4CAF50;
  margin-bottom: 10rpx;
}

.result-item .comments {
  margin-top: 15rpx;
}

.comment-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.comment-item {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 2rpx solid #e0e0e0;
}

.modal-footer button {
  border: none;
  border-radius: 10rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  min-width: 120rpx;
}

.cancel-btn {
  background: #f0f0f0;
  color: #333;
}

.confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.export-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
}