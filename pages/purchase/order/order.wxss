/* purchase/order/order.wxss */
.container {
  background-color: #f6f6f6;
  min-height: 100vh;
  padding: 20rpx;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: white;
  border-radius: 10rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  background-color: #019fa0;
  color: white;
  border-radius: 25rpx;
  font-size: 28rpx;
  padding: 15rpx 25rpx;
}

.filter-bar {
  display: flex;
  margin-bottom: 30rpx;
  background-color: white;
  padding: 20rpx;
  border-radius: 10rpx;
}

.filter-btn {
  flex: 1;
  margin: 0 10rpx;
  font-size: 26rpx;
  padding: 15rpx;
  border-radius: 25rpx;
  background-color: #f0f0f0;
  color: #666;
}

.filter-btn.active {
  background-color: #019fa0;
  color: white;
}

.order-list {
  margin-bottom: 20rpx;
}

.order-item {
  background-color: white;
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-number {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.order-status {
  font-size: 26rpx;
  padding: 5rpx 15rpx;
  border-radius: 15rpx;
}

.order-status.pending {
  background-color: #fff3e0;
  color: #ff9800;
}

.order-status.approved {
  background-color: #e8f5e8;
  color: #4caf50;
}

.order-status.rejected {
  background-color: #ffebee;
  color: #f44336;
}

.supplier-info {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.order-details {
  margin-bottom: 20rpx;
}

.detail-item {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  margin-left: 15rpx;
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  border-radius: 5rpx;
}

.action-btn.view {
  background-color: #e3f2fd;
  color: #1976d2;
}

.action-btn.approve {
  background-color: #e8f5e8;
  color: #4caf50;
}

.action-btn.reject {
  background-color: #ffebee;
  color: #f44336;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
